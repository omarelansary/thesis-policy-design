{
  "model": "claude-sonnet-5-5",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python tools/origin_extract.py *)",
      "Bash(python tools/verify_workspace.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(python tools/litfetch.py *)",
      "WebSearch",
      "WebFetch",
      "Bash(git commit*)",
      "Bash(git push origin v5-audit)",
      "Bash(git push -u origin v5-audit)",
      "Bash(git branch --show-current*)",
      "Bash(git rev-parse*)",
      "Agent",
      "Bash(python design/package-v5/calc/*)",
      "Bash(python design/package-v5/tools/*)",
      "Bash(python ops/tests/guard_cases.py*)",
      "Bash(python design/ledger/export_ledger.py*)"
    ],
    "ask": [
      "PowerShell(git commit*)",
      "Artifact",
      "mcp__claude_ai_Claude_Docs"
    ],
    "deny": [
      "Read(//c/Users/omr/Documents/research-cleanroom/**)",
      "Edit(//c/Users/omr/Documents/research-cleanroom/**)",
      "Read(//c/Users/omr/Documents/research-cleanroom-backups-20261011/**)",
      "Read(//c/Users/omr/Documents/thesis-backups/**)",
      "Read(//c/Users/omr/Documents/claude_forensic_rescue_2026-10-02/**)",
      "Read(~/.claude/projects/**)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.claude/file-history/**)",
      "Read(~/.claude/plans/**)",
      "Read(~/.claude/backups/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push *main*)",
      "Bash(git remote*)",
      "Bash(git clone*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git config*)",
      "Bash(pip install*)",
      "Bash(python -m pip install*)",
      "Bash(npm install*)",
      "Bash(winget*)",
      "Bash(choco*)",
      "PowerShell(git push*)",
      "PowerShell(git remote*)",
      "PowerShell(git clone*)",
      "PowerShell(git pull*)",
      "PowerShell(git fetch*)",
      "PowerShell(git config*)",
      "PowerShell(pip install*)",
      "PowerShell(npm install*)",
      "PowerShell(winget*)",
      "Skill(import-memory)",
      "Skill(anthropic-skills:import-memory)",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "RemoteTrigger",
      "PushNotification",
      "CronCreate",
      "ScheduleWakeup",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)",
      "Bash(*settings.local*)",
      "PowerShell(*settings.local*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Write|Edit|NotebookEdit|MultiEdit|SendMessage",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
